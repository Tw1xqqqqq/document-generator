# Точка входа снаружи. Caddy сам выпускает и продлевает
# сертификат Let's Encrypt для указанного домена.

# Контактный адрес для Let's Encrypt не обязателен: сертификат
# продлевается автоматически. Если нужны письма об истечении,
# раскомментируйте блок и подставьте реальную почту (адреса на
# example.com центр сертификации отклоняет).
#
# {
# 	email admin@ваш-домен
# }

{$SITE_ADDRESS} {
	encode zstd gzip

	# Ограничение доступа паролем.
	# Раскомментируйте и подставьте хэш, полученный командой:
	#   docker compose exec caddy caddy hash-password --plaintext 'ваш-пароль'
	#
	# basic_auth {
	# 	admin $2a$14$хэш-пароля
	# }

	# Документы могут быть большими, поэтому предел выше стандартного
	request_body {
		max_size 32MB
	}

	# Конвертация в PDF занимает время: LibreOffice не должен
	# обрываться по таймауту на тяжёлых документах
	reverse_proxy nginx:80 {
		transport http {
			response_header_timeout 180s
			read_timeout 180s
		}
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
