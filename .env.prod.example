# Настройки развёртывания на сервере.
# Скопируйте файл в .env рядом с docker-compose.yml и заполните значения:
#   cp .env.prod.example .env

# Адрес, который обслуживает прокси.
#   documents.example.com    - домен, сертификат выпускается автоматически
#   http://203.0.113.10      - пока домена нет, работа по обычному http
# Домен должен указывать на этот сервер (A-запись в DNS),
# иначе Let's Encrypt не выдаст сертификат.
SITE_ADDRESS=documents.example.com

# Полный адрес сервиса: подставляется в ссылки на файлы и логотипы
APP_URL=https://documents.example.com

# Заливать ли демонстрационные организации и шаблоны при первом запуске.
# true удобно для показа работодателю, false для реальной эксплуатации.
SEED_DEMO_DATA=false
