# Настройки развёртывания на сервере.
# Скопируйте файл в .env рядом с docker-compose.yml и заполните значения:
#   cp .env.prod.example .env

# Домен, на котором работает сервис. Должен указывать на этот сервер
# (A-запись в DNS), иначе Let's Encrypt не выдаст сертификат.
DOMAIN=documents.example.com

# Почта для уведомлений Let's Encrypt об истечении сертификата
LETSENCRYPT_EMAIL=admin@example.com

# Заливать ли демонстрационные организации и шаблоны при первом запуске.
# true удобно для показа работодателю, false для реальной эксплуатации.
SEED_DEMO_DATA=false
